! ============================================================
! 64 ATOMS - stopping power, moving alpha particle
!
! Ions frozen at the equilibrated BOMD snapshot
! (BOMD/Relative_Positions.data, frame -1, t = 6000.0 a.u.).
!
! Ecut = 375 eV -> grid 30 30 30, from SHRED's own rule
!     Ng = round(2 L sqrt(2 Ecut) / pi)   (inputs.f90:1178)
! with L = 4.75 Ang = 8.97619909 bohr. The 30^3 window is 363-387 eV.
!
! WARNING: 30^3 gives h = 0.299 bohr, COARSER than the 8-atom Ecut=1000
! eV run (24^3, h = 0.187 bohr) that came out 27% below the 4234 eV
! value. With the bare Coulomb projectile below, this grid cannot give
! a converged stopping power - it is a mechanics/throughput run only.
! ============================================================

&task_list
run_Time_Dependent=.true.
run_Stopping_Power=.true.
/

&parallel_groups
n_spin_groups=1
n_k_groups=1
n_band_groups=1
/

&system_parameters
Temperature_eV = 2.0
Number_of_elements = 1
Number_of_KS_orbitals = 96
Number_of_stoch_vect = 0
/

&xc_functional
exchange='GGA_X_PBE'
correlation='GGA_C_PBE'
/

&simulation_grid
Length_Angst = 4.75 4.75 4.75
Ecut = 375 !eV
/

! Host ions frozen: we want ELECTRONIC stopping, so the energy must
! go into electrons rather than into recoiling protons.
&element_list
Number_of_atoms_of_element = 64
PP_file = '1h.1.hgh'
PP_type ='HGH'
Projector_Application = 'Real_local'
Mass_amu = 1.008
frozen_positions=.true.
frozen_velocities=.true.
/

