! TIMESTEP TEST. dt halved to 0.0025 with nt doubled to 2154, so the total
! time is unchanged at 5.385 a.u. = 3 cell crossings and the two runs sample
! the SAME trajectory, one twice as finely.
!
! Question: is the high-frequency content of S(t) physical or propagator
! error? At dt=0.005 the rms step-to-step change was 0.0777 Ha/bohr, ~1.8x
! what a smooth oscillation of that amplitude and period would give.
!   physical  -> S(t) overlays point for point, rms dS/step HALVES
!   numerical -> rms dS/step stays ~0.0777, i.e. |dS/dt| doubles
!
! Everything else is held fixed, err_allowed included - changing the
! propagator tolerance here would confound the test.
&Time_Dependent
BOMD_or_RealTime = 'RealTime'
Thermostat = 'IsoEnergy'
dt = 0.0025
nt = 2154
err_allowed = 1.0E-6
SIL_rank = 10
ETRS_steps = 1
energy_print_mod = 5
pressure_print_mod = 100
/

&numerics
pulay_max_iter=200
pulay_n=6
pulay_k=3
pulay_L2_eps=1.0E-5
pulay_eig_eps=1.0E-6
lobpcg_inner_steps=6
n_scf_delay=2
/
